rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownsExisting() { return signedIn() && resource.data.uid == request.auth.uid; }
    function ownsIncoming() { return signedIn() && request.resource.data.uid == request.auth.uid; }

    match /{collection}/{docId} {
      allow read, delete: if collection in ['meals', 'snacks', 'diary'] && ownsExisting();
      allow create: if collection in ['meals', 'snacks', 'diary'] && ownsIncoming();
      allow update: if collection in ['meals', 'snacks', 'diary'] && ownsExisting() && ownsIncoming();
    }
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    match /dailyMeals/{docId} {
      // Queries must include where('uid', '==', currentUser.uid).
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming()
        && request.resource.data.date is string
        && docId == request.auth.uid + '_' + request.resource.data.date;
      allow update: if ownsExisting() && ownsIncoming()
        && request.resource.data.date is string
        && docId == request.auth.uid + '_' + request.resource.data.date;
    }
  }
}
